<Project Sdk="Microsoft.NET.Sdk">

  <!--
    L'application de bureau de SIG ENSOA : une fenêtre qui ouvre la PWA, sans
    barre d'adresse, avec le moteur d'Edge (WebView2) déjà présent sur
    Windows 10 et 11.

    Elle vise le .NET Framework 4.8, livré avec Windows : rien d'autre à
    installer sur les postes, et un exécutable de quelques centaines de Ko.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>sig_ensoa</AssemblyName>
    <RootNamespace>SigEnsoa</RootNamespace>
    <ApplicationIcon>..\windows\runner\resources\app_icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>SIG ENSOA</Product>
    <Company>Ecole Nationale des Sous-Officiers d'Active</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="hors_ligne.html" LogicalName="hors_ligne.html" />
    <EmbeddedResource Include="..\windows\runner\resources\app_icon.ico" LogicalName="app_icon.ico" />
  </ItemGroup>

</Project>
